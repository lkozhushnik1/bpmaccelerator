# Copy this file to .env.local and adjust as needed.
#
# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run the frontend with pre-built fixture data.
# No backend is required when this flag is on.
# Unset (or set to "false") to connect to a live API server.
#
NEXT_PUBLIC_DEMO_MODE=true

# ── API URL ───────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend.
# Only used when NEXT_PUBLIC_DEMO_MODE is not "true".
#
NEXT_PUBLIC_API_URL=http://localhost:8000
